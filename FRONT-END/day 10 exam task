<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StartupX</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">StartupX</a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#services">Services</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ================= HERO SECTION ================= -->

    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">

        <div class="carousel-inner">

            <!-- Slide 1 -->
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?q=80&w=1200"
                    class="d-block w-100 carousel-img" alt="Business">

                <div class="carousel-caption">
                    <h1>Grow Your Business</h1>
                    <p>We provide modern business solutions for startups.</p>
                    <button class="btn btn-primary">Explore</button>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=1200"
                    class="d-block w-100 carousel-img" alt="Team">

                <div class="carousel-caption">
                    <h1>Innovative Ideas</h1>
                    <p>Transform your future with smart digital services.</p>
                    <button class="btn btn-success">Learn More</button>
                </div>
            </div>

        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>

    <!-- ================= SERVICES SECTION ================= -->

    <section id="services" class="py-5">
        <div class="container">

            <h2 class="text-center mb-5">Our Services</h2>

            <div class="row g-4">

                <!-- Card 1 -->
                <div class="col-md-4">
                    <div class="card h-100 shadow">
                        <img src="https://cdn-icons-png.flaticon.com/512/1055/1055687.png"
                            class="card-img-top service-img p-4" alt="">

                        <div class="card-body text-center">
                            <h5 class="card-title">Web Development</h5>
                            <p class="card-text">
                                Responsive and modern websites for your business growth.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="col-md-4">
                    <div class="card h-100 shadow">
                        <img src="https://cdn-icons-png.flaticon.com/512/1995/1995574.png"
                            class="card-img-top service-img p-4" alt="">

                        <div class="card-body text-center">
                            <h5 class="card-title">Digital Marketing</h5>
                            <p class="card-text">
                                Increase your online presence and customer engagement.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="col-md-4">
                    <div class="card h-100 shadow">
                        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                            class="card-img-top service-img p-4" alt="">

                        <div class="card-body text-center">
                            <h5 class="card-title">Business Consulting</h5>
                            <p class="card-text">
                                Expert guidance to scale and improve your business.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ================= ACHIEVEMENTS SECTION ================= -->

    <section id="about" class="stats-section py-5">
        <div class="container">

            <h2 class="text-center mb-5">Our Achievements</h2>

            <div class="row text-center">

                <div class="col-6 col-md-3 mb-4">
                    <h1>500+</h1>
                    <p>Clients</p>
                </div>

                <div class="col-6 col-md-3 mb-4">
                    <h1>1200+</h1>
                    <p>Projects</p>
                </div>

                <div class="col-6 col-md-3 mb-4">
                    <h1>50+</h1>
                    <p>Awards</p>
                </div>

                <div class="col-6 col-md-3 mb-4">
                    <h1>10+</h1>
                    <p>Years Experience</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ================= CONTACT FORM ================= -->

    <section id="contact" class="py-5">
        <div class="container">

            <h2 class="text-center mb-5">Contact Us</h2>

            <div class="row justify-content-center">

                <div class="col-md-8">

                    <form>

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" class="form-control" placeholder="Enter your name">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="Enter your email">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="5"
                                placeholder="Enter your message"></textarea>
                        </div>

                        <div class="text-center">
                            <button class="btn btn-dark px-4">Submit</button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </section>

    <!-- ================= FOOTER ================= -->

    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-1">© 2026 StartupX. All Rights Reserved.</p>
        <p class="mb-0">Made by Student</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
